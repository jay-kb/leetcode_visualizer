<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.leetcode.visualizer.mapper.ViewStatsTotalMapper">

    <!-- 查询指定日期的总浏览量 -->
    <select id="selectByDate" resultType="com.leetcode.visualizer.entity.ViewStatsTotal">
        SELECT * FROM view_stats_total
        WHERE stat_date = #{statDate}
    </select>

    <!-- 统计日期范围内的总浏览量 -->
    <select id="sumTotalViews" resultType="java.lang.Long">
        SELECT COALESCE(SUM(total_views), 0)
        FROM view_stats_total
        WHERE stat_date BETWEEN #{startDate} AND #{endDate}
    </select>

</mapper>
