# API 配置示例
# 复制此文件为 .env 并修改对应的值

# ==================== API 基础地址 ====================
# 开发环境
# VITE_API_BASE_URL=http://localhost:8080/api

# 生产环境（替换为你的域名）
# VITE_API_BASE_URL=https://api.yourdomain.com/api

# ==================== 管理后台地址 ====================
# 用于首页的"管理后台"按钮链接
# 开发环境
# VITE_ADMIN_URL=http://localhost:8083

# 生产环境（替换为你的域名）
# VITE_ADMIN_URL=https://admin.yourdomain.com
