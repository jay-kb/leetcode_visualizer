# API 配置示例
# 复制此文件为 .env 并修改对应的值

# ==================== API 基础地址 ====================
# 开发环境
# VITE_API_BASE_URL=http://localhost:8080/api

# 生产环境（替换为你的域名）
# VITE_API_BASE_URL=https://api.yourdomain.com/api

# ==================== 管理后台地址 ====================
# 用于首页的"管理后台"按钮链接
# 开发环境
# VITE_ADMIN_URL=http://localhost:8083

# 生产环境（替换为你的域名）
# VITE_ADMIN_URL=https://admin.yourdomain.com

# ==================== GitHub 仓库地址 ====================
# 用于首页导航栏的 GitHub 跳转图标
# 设置为空则不显示图标
# 示例: VITE_GITHUB_URL=https://github.com/yourusername/repo
# VITE_GITHUB_URL=

# ==================== 联系邮箱 ====================
# 用于首页导航栏的邮箱图标，点击可复制
# 设置为空则不显示图标
# 示例: VITE_CONTACT_EMAIL=contact@example.com
# VITE_CONTACT_EMAIL=

# ==================== 备案信息 ====================
# ICP 备案号（设置后显示在底部）
# 示例: VITE_ICP_LICENSE=京ICP备12345678号
# VITE_ICP_LICENSE=

# 公安备案号（设置后显示在底部）
# 示例: VITE_POLICE_LICENSE=京公网安备11010500000000号
# VITE_POLICE_LICENSE=
