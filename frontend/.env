# API 基础地址（完整域名方式，如 https://api.example.com）
# 开发环境可以设置为 http://localhost:8080/api
# VITE_API_BASE_URL=https://mabelle-gapy-cicely.ngrok-free.dev/api
VITE_API_BASE_URL=http://localhost:8080/api

# 管理后台地址（用于首页的"管理后台"按钮链接）
# 开发环境: http://localhost:8083
# 生产环境: https://admin.yourdomain.com
# VITE_ADMIN_URL=https://mabelle-gapy-cicely.ngrok-free.dev/api
VITE_ADMIN_URL=http://localhost:8083
VITE_CONTACT_EMAIL=3020127810@qq.com
VITE_GITHUB_URL=https://github.com/jay-kb/leetcode_visualizer

# ==================== 备案信息 ====================
# ICP 备案号（设置后显示在底部）
# 示例: VITE_ICP_LICENSE=京ICP备12345678号
VITE_ICP_LICENSE=京ICP备12345678号

# 公安备案号（设置后显示在底部）
# 示例: VITE_POLICE_LICENSE=京公网安备11010500000000号
VITE_POLICE_LICENSE=京公网安备11010500000000号